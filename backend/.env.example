# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:   mongodb://127.0.0.1:27017/spendwise
# Atlas:   mongodb+srv://<user>:<pass>@<cluster>/spendwise?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/spendwise

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma separated list of allowed origins (Flutter web / admin tools).
# Mobile apps (Android/iOS) don't send an Origin header so they aren't affected.
CORS_ORIGINS=http://localhost:3000
